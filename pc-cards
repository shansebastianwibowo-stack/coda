<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payment Channels Directory</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      padding: 16px;
      width: 100%;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      color: #1e293b;
      background: #f8fafc;
      font-size: 12px;
    }

    .filter-grid-pc {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 14px;
      max-width: 750px;
    }
    .filter-group-pc { display: flex; flex-direction: column; gap: 4px; }
    .filter-group-pc label {
      font-size: 10px;
      font-weight: 700;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .filter-group-pc input,
    .filter-group-pc select {
      font-size: 10px;
      padding: 6px 10px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      outline: none;
      background-color: #fff;
      width: auto;
    }
    #searchInput   { width: 220px; }
    #regionSelect  { width: 140px; }
    #countrySelect { width: 160px; }
    #typeSelect    { width: 170px; }
    #productSelect { width: 140px; }

    .meta-info-pc {
      font-size: 12px;
      color: #64748b;
      margin-bottom: 12px;
      font-weight: 500;
    }

    .card-grid {
      display: flex;
      flex-direction: column;
      gap: 12px;
      max-width: 750px;
    }

    .pc-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      overflow: hidden;
    }

    .pc-card-header {
      padding: 10px 14px;
      background: #0f172a;
    }
    .pc-card-title {
      font-size: 15px;
      font-weight: 700;
      color: #ffffff;
      margin: 0;
    }

    .pc-kv {
      display: flex;
      gap: 10px;
      padding: 12px 14px;
      align-items: stretch;
    }
    .pc-category {
      flex: 1;
      display: flex;
      flex-direction: column;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      background: #fbfcfd;
      overflow: hidden;
    }
    .pc-category-label {
      background: #eef2f6;
      color: #475569;
      font-size: 9px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      padding: 5px 8px;
      border-bottom: 1px solid #e2e8f0;
    }
    .pc-category-body {
      padding: 8px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      flex: 1;
    }
    .pc-kv-item { font-size: 9px; }
    .pc-kv-label {
      display: block;
      color: #64748b;
      font-size: 9px;
      margin-bottom: 1px;
    }
    .pc-kv-value {
      font-weight: 600;
      color: #1e293b;
    }
    .pc-kv-value.mono { font-family: ui-monospace, monospace; font-weight: 500; }
    .pc-kv-value.multiline { white-space: pre-line; line-height: 1.4; }

    .pc-collapse-inline {
      margin-top: 6px;
    }

    .pc-product-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
      margin-top: 2px;
    }
    .pc-product-tag {
      font-size: 9px;
      font-weight: 600;
      padding: 2px 6px;
      border-radius: 4px;
      background: #f1f5f9;
      color: #334155;
    }

    .pc-status-list {
      display: flex;
      flex-direction: column;
      gap: 3px;
      margin-top: 2px;
    }
    .pc-status-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      font-size: 9px;
    }
    .pc-status-name { color: #1e293b; font-weight: 600; }
    .pc-status-badge {
      display: inline-block;
      padding: 1px 7px;
      border-radius: 999px;
      font-size: 8px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      white-space: nowrap;
    }
    .pc-status-badge.active   { background: #dcfce7; color: #15803d; }
    .pc-status-badge.inactive { background: #fee2e2; color: #b91c1c; }
    .pc-status-badge.unknown  { background: #f1f5f9; color: #64748b; }

    .pc-toggle {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 9px;
      font-weight: 600;
      padding: 3px 8px;
      border-radius: 6px;
      border: 1px solid #cbd5e1;
      background: #f8fafc;
      color: #1e293b;
      cursor: pointer;
    }
    .pc-toggle:hover { background: #f1f5f9; }
    .pc-toggle.is-static {
      cursor: default;
      background: transparent;
      border-color: transparent;
      padding: 3px 0;
    }
    .pc-toggle .chevron {
      font-size: 9px;
      transition: transform 0.15s ease;
    }
    .pc-toggle[aria-expanded="true"] .chevron { transform: rotate(180deg); }

    .pc-collapse {
      display: none;
      padding: 8px 10px;
      border: 1px dashed #e2e8f0;
      border-radius: 6px;
      background: #fafbfc;
      margin-top: 4px;
    }
    .pc-collapse.is-open { display: block; }

    .pc-collapse-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .pc-collapse-item { font-size: 9px; }
    .pc-collapse-label { display: block; color: #64748b; font-size: 9px; }
    .pc-collapse-value { font-weight: 600; color: #1e293b; }
    .pc-collapse-full { grid-column: 1 / -1; }

    .pc-pricelist {
      font-size: 9px;
      color: #1e293b;
      line-height: 1.5;
      max-height: 140px;
      overflow-y: auto;
      background: #fff;
      border: 1px solid #eef1f4;
      border-radius: 6px;
      padding: 6px 8px;
    }

    .pc-note {
      font-size: 9px;
      color: #475569;
      background: #fffbeb;
      border: 1px solid #fde68a;
      border-radius: 6px;
      padding: 8px 10px;
      white-space: pre-line;
      line-height: 1.5;
    }
    .pc-note-label {
      display: block;
      font-size: 9px;
      font-weight: 700;
      color: #92400e;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      margin-bottom: 3px;
    }
    .pc-note-label.important {
      color: #b91c1c;
      margin-top: 8px;
    }
    .pc-note-divider {
      border-top: 1px dashed #fde68a;
      margin: 8px 0;
    }
    .pc-note .bang {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: #dc2626;
      color: #fff;
      font-size: 8px;
      font-weight: 800;
      line-height: 1;
      margin-right: 3px;
    }

    .pc-note-toggle {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 9px;
      font-weight: 600;
      padding: 4px 9px;
      border-radius: 6px;
      border: 1px solid #fecaca;
      background: #fef2f2;
      color: #b91c1c;
      cursor: pointer;
    }
    .pc-note-toggle:hover { background: #fee2e2; }
    .pc-note-toggle .bang {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: #dc2626;
      color: #fff;
      font-size: 10px;
      font-weight: 800;
      line-height: 1;
    }
    .pc-note-toggle .chevron {
      font-size: 9px;
      transition: transform 0.15s ease;
    }
    .pc-note-toggle[aria-expanded="true"] .chevron { transform: rotate(180deg); }

    .pc-empty {
      text-align: center;
      padding: 40px 20px;
      color: #64748b;
      font-size: 9px;
    }

    .pc-codapay-only.pc-hidden { display: none; }
  </style>
</head>
<body>

  <div class="filter-grid-pc">
    <div class="filter-group-pc">
      <label for="searchInput">Search</label>
      <input type="text" id="searchInput" placeholder="Search channel, product, ID..." />
    </div>
    <div class="filter-group-pc">
      <label for="regionSelect">Region</label>
      <select id="regionSelect"><option value="">All Regions</option></select>
    </div>
    <div class="filter-group-pc">
      <label for="countrySelect">Country</label>
      <select id="countrySelect"><option value="">All Countries</option></select>
    </div>
    <div class="filter-group-pc">
      <label for="typeSelect">Type</label>
      <select id="typeSelect"><option value="">All Types</option></select>
    </div>
    <div class="filter-group-pc">
      <label for="productSelect">Applicable Product</label>
      <select id="productSelect">
        <option value="">All Products</option>
        <option value="Codapay">Codapay</option>
        <option value="Codashop">Codashop</option>
        <option value="Webstore">Webstore</option>
      </select>
    </div>
  </div>

  <div class="meta-info-pc" id="countDisplay">Fetching payment channels...</div>

  <div class="card-grid" id="cardGrid"></div>

  <script>
    const SPREADSHEET_ID = '19txcCv_OTSISqQYDQObvQSfSpMCkHj4gBjmUw6oyd-w';
    const GID = '0';
    const CSV_URL = `https://docs.google.com/spreadsheets/d/${SPREADSHEET_ID}/export?format=csv&gid=${GID}`;

    let rawData = [];
    let cardIdCounter = 0;

    function formatNumber(val) {
      if (!val || isNaN(String(val).replace(/,/g, ''))) return val || '-';
      const num = parseFloat(String(val).replace(/,/g, ''));
      return num.toLocaleString();
    }

    function isEmptyValue(v) {
      if (v === undefined || v === null) return true;
      const t = String(v).trim();
      return t === '' || t.toUpperCase() === 'N/A' || t === '-';
    }

    function displayOrDash(v) {
      return isEmptyValue(v) ? '-' : v;
    }

    function parseCSV(text) {
      const rows = [];
      let row = [];
      let field = '';
      let inQuotes = false;

      for (let i = 0; i < text.length; i++) {
        const char = text[i];
        const next = text[i + 1];

        if (inQuotes) {
          if (char === '"') {
            if (next === '"') { field += '"'; i++; }
            else { inQuotes = false; }
          } else {
            field += char;
          }
        } else {
          if (char === '"') {
            inQuotes = true;
          } else if (char === ',') {
            row.push(field); field = '';
          } else if (char === '\r') {
            // ignore
          } else if (char === '\n') {
            row.push(field); rows.push(row); row = []; field = '';
          } else {
            field += char;
          }
        }
      }
      if (field.length > 0 || row.length > 0) { row.push(field); rows.push(row); }

      return rows.slice(1).filter(cols => !(cols.length === 1 && cols[0].trim() === '')).map(cols => {
        const get = (i) => (cols[i] !== undefined ? cols[i].trim() : '');
        return {
          region: get(0) || '-',
          country: get(1) || '-',
          currency: get(2) || '-',
          channel: get(3) || '-',
          type: get(4) || '-',
          channelId: get(5) || '-',
          min: formatNumber(get(6)),
          max: formatNumber(get(7)),
          pricePointType: get(8) || '-',
          decimalSupport: get(9) || '-',
          apiIntegration: get(10) || '-',
          product: get(11).replace(/\s+/g, ' ').trim() || '-',
          specialRequirement: get(12),
          importantNote: get(13),
          otherLimits: get(14),
          apiPayType: get(15),
          apiPayAt: get(16),
          apiMnoCode: get(17),
          apiPayChannel: get(18),
          apiMandatoryFields: get(19),
          transactionExpiry: get(20),
          priceWebPc: get(21),
          priceMobile: get(22),
          priceNonGaming: get(23),
          supportedApiIntegration: get(24),
          channelStatus: get(25),
        };
      });
    }

    async function loadData() {
      try {
        const res = await fetch(CSV_URL);
        if (!res.ok) throw new Error('Network error');
        const text = await res.text();
        rawData = parseCSV(text);
        populateDropdowns();
        applyURLPresets();
        renderCards();
      } catch (err) {
        document.getElementById('countDisplay').innerText = 'Unable to load payment channels. Please ensure the Google Sheet is published to web.';
      }
    }

    function populateDropdowns() {
      const regions = [...new Set(rawData.map(d => d.region))].filter(v => v !== '-').sort();
      const countries = [...new Set(rawData.map(d => d.country))].filter(v => v !== '-').sort();
      const types = [...new Set(rawData.map(d => d.type))].filter(v => v !== '-').sort();

      fillSelect('regionSelect', regions, 'All Regions');
      fillSelect('countrySelect', countries, 'All Countries');
      fillSelect('typeSelect', types, 'All Types');
    }

    function applyURLPresets() {
      const params = new URLSearchParams(window.location.search);
      const presetProduct = params.get('product');
      if (presetProduct) {
        const sel = document.getElementById('productSelect');
        const validOptions = Array.from(sel.options).map(o => o.value);
        if (validOptions.includes(presetProduct)) sel.value = presetProduct;
      }
    }

    function fillSelect(id, items, defaultText) {
      const sel = document.getElementById(id);
      sel.innerHTML = `<option value="">${defaultText}</option>` + items.map(i => `<option value="${i}">${i}</option>`).join('');
    }

    function escapeHtml(str) {
      return String(str).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }

    function renderProductTags(productStr) {
      const tags = productStr.split(/\n|(?=\[)/).map(t => t.trim()).filter(Boolean);
      if (tags.length === 0) return '-';
      return `<div class="pc-product-tags">${tags.map(t => `<span class="pc-product-tag">${escapeHtml(t)}</span>`).join('')}</div>`;
    }

    function renderProductStatus(productStr, statusStr) {
      const applicableProducts = productStr
        .split(/\n|(?=\[)/)
        .map(t => t.trim().replace(/^\[|\]$/g, ''))
        .filter(Boolean);

      if (applicableProducts.length === 0) return '-';

      const statusMap = {};
      if (!isEmptyValue(statusStr)) {
        statusStr.split('\n').forEach(line => {
          const idx = line.indexOf(':');
          if (idx === -1) return;
          const name = line.slice(0, idx).trim();
          const status = line.slice(idx + 1).trim();
          if (name) statusMap[name] = status;
        });
      }

      const rows = applicableProducts.map(product => {
        const rawStatus = statusMap[product] || '';
        let badgeClass = 'unknown';
        let badgeText = rawStatus || '—';
        const normalized = rawStatus.toLowerCase();
        if (normalized === 'active') badgeClass = 'active';
        else if (normalized === 'inactive') badgeClass = 'inactive';

        return `
          <div class="pc-status-row">
            <span class="pc-status-name">${escapeHtml(product)}</span>
            <span class="pc-status-badge ${badgeClass}">${escapeHtml(badgeText)}</span>
          </div>
        `;
      });

      return `<div class="pc-status-list">${rows.join('')}</div>`;
    }

    function renderPriceList(label, raw) {
      if (isEmptyValue(raw)) return '';
      const items = raw.split('\n').map(v => v.trim()).filter(Boolean);
      return `
        <div class="pc-collapse-item pc-collapse-full">
          <span class="pc-collapse-label">${escapeHtml(label)}</span>
          <div class="pc-pricelist">${items.map(escapeHtml).join(', ')}</div>
        </div>
      `;
    }

    function buildCard(d) {
      cardIdCounter++;
      const apiId = `api-collapse-${cardIdCounter}`;
      const priceId = `price-collapse-${cardIdCounter}`;

      const apiFields = [
        ['Pay Type', d.apiPayType],
        ['Pay At', d.apiPayAt],
        ['mno_code', d.apiMnoCode],
        ['Pay Channel', d.apiPayChannel],
        ['Mandatory Fields', d.apiMandatoryFields],
      ];
      const apiHasData = apiFields.some(([, v]) => !isEmptyValue(v));

      const apiToggleHtml = apiHasData
        ? `<button type="button" class="pc-toggle" aria-expanded="false"
             onclick="pcToggle('${apiId}', this)">${escapeHtml(d.apiIntegration)} <span class="chevron">▾</span></button>`
        : `<span class="pc-toggle is-static">${escapeHtml(d.apiIntegration)}</span>`;

      const apiCollapseBody = apiHasData
        ? `<div class="pc-collapse-grid">
             ${apiFields.map(([label, v]) => isEmptyValue(v) ? '' : `
               <div class="pc-collapse-item">
                 <span class="pc-collapse-label">${escapeHtml(label)}</span>
                 <span class="pc-collapse-value">${escapeHtml(v)}</span>
               </div>
             `).join('')}
           </div>`
        : '';

      const priceFields = [
        ['Web/PC Content', d.priceWebPc],
        ['Mobile Content', d.priceMobile],
        ['Non Gaming Content', d.priceNonGaming],
      ];
      const priceHasData = d.pricePointType.trim() === 'Fixed Price Points'
        && priceFields.some(([, v]) => !isEmptyValue(v));

      const priceToggleHtml = priceHasData
        ? `<button type="button" class="pc-toggle" aria-expanded="false"
             onclick="pcToggle('${priceId}', this)">${escapeHtml(d.pricePointType)} <span class="chevron">▾</span></button>`
        : `<span class="pc-toggle is-static">${escapeHtml(d.pricePointType)}</span>`;

      const priceCollapseBody = priceHasData
        ? `<div class="pc-collapse-grid">${priceFields.map(([label, v]) => renderPriceList(label, v)).join('')}</div>`
        : '';

      const specialReqValue = isEmptyValue(d.specialRequirement) ? 'None' : d.specialRequirement;
      const hasImportantNote = !isEmptyValue(d.importantNote);

      return `
        <div class="pc-card">
          <div class="pc-card-header">
            <p class="pc-card-title">${escapeHtml(d.channel)}</p>
          </div>

          <div class="pc-kv">
            <div class="pc-category">
              <div class="pc-category-label">General Information</div>
              <div class="pc-category-body">
                <div class="pc-kv-item"><span class="pc-kv-label">Region</span><span class="pc-kv-value">${escapeHtml(d.region)}</span></div>
                <div class="pc-kv-item"><span class="pc-kv-label">Country</span><span class="pc-kv-value">${escapeHtml(d.country)}</span></div>
                <div class="pc-kv-item"><span class="pc-kv-label">Currency</span><span class="pc-kv-value">${escapeHtml(d.currency)}</span></div>
                <div class="pc-kv-item"><span class="pc-kv-label">Type</span><span class="pc-kv-value">${escapeHtml(d.type)}</span></div>
                <div class="pc-kv-item">
                  <span class="pc-kv-label">Applicable Product/Status</span>
                  ${renderProductStatus(d.product, d.channelStatus)}
                </div>
              </div>
            </div>

            <div class="pc-category">
              <div class="pc-category-label">Technical Information</div>
              <div class="pc-category-body">
                <div class="pc-kv-item"><span class="pc-kv-label">Min</span><span class="pc-kv-value">${escapeHtml(d.min)}</span></div>
                <div class="pc-kv-item"><span class="pc-kv-label">Max</span><span class="pc-kv-value">${escapeHtml(d.max)}</span></div>
                <div class="pc-kv-item"><span class="pc-kv-label">Other Limits</span><span class="pc-kv-value">${escapeHtml(displayOrDash(d.otherLimits))}</span></div>
                <div class="pc-kv-item"><span class="pc-kv-label">Decimal Support</span><span class="pc-kv-value">${escapeHtml(d.decimalSupport)}</span></div>
                <div class="pc-kv-item"><span class="pc-kv-label">Transaction Expiry Time</span><span class="pc-kv-value">${escapeHtml(displayOrDash(d.transactionExpiry))}</span></div>
                <div class="pc-kv-item">
                  <span class="pc-kv-label">Price Point Type</span>
                  ${priceToggleHtml}
                  ${priceHasData ? `<div class="pc-collapse pc-collapse-inline" id="${priceId}">${priceCollapseBody}</div>` : ''}
                </div>
                <div class="pc-kv-item"><span class="pc-kv-label">Channel ID/payType</span><span class="pc-kv-value mono">${escapeHtml(d.channelId)}</span></div>
                <div class="pc-kv-item pc-codapay-only"><span class="pc-kv-label">Supported API Integration</span><span class="pc-kv-value multiline">${escapeHtml(displayOrDash(d.supportedApiIntegration))}</span></div>
                <div class="pc-kv-item pc-codapay-only">
                  <span class="pc-kv-label">Backend API Integration</span>
                  ${apiToggleHtml}
                  ${apiHasData ? `<div class="pc-collapse pc-collapse-inline" id="${apiId}">${apiCollapseBody}</div>` : ''}
                </div>
              </div>
            </div>

            <div class="pc-category">
              <div class="pc-category-label">Additional Information</div>
              <div class="pc-category-body">
                <div class="pc-kv-item">
                  <div class="pc-note">
                    <span class="pc-note-label">Special Requirement</span>${escapeHtml(specialReqValue)}
                    ${hasImportantNote ? `
                      <div class="pc-note-divider"></div>
                      <span class="pc-note-label important">
                        <span class="bang">!</span> Important Note
                      </span>${escapeHtml(d.importantNote)}
                    ` : ''}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      `;
    }

    function renderCards() {
      const search = document.getElementById('searchInput').value.toLowerCase();
      const region = document.getElementById('regionSelect').value;
      const country = document.getElementById('countrySelect').value;
      const type = document.getElementById('typeSelect').value;
      const product = document.getElementById('productSelect').value;

      const filtered = rawData.filter(d => {
        const matchSearch = !search ||
          d.channel.toLowerCase().includes(search) ||
          d.country.toLowerCase().includes(search) ||
          d.channelId.toLowerCase().includes(search) ||
          d.product.toLowerCase().includes(search);
        const matchRegion = !region || d.region === region;
        const matchCountry = !country || d.country === country;
        const matchType = !type || d.type === type;
        const matchProduct = !product || d.product.toLowerCase().includes(product.toLowerCase());
        return matchSearch && matchRegion && matchCountry && matchType && matchProduct;
      });

      document.getElementById('countDisplay').innerText = `Showing ${filtered.length} channel(s)`;
      const grid = document.getElementById('cardGrid');

      if (filtered.length === 0) {
        grid.innerHTML = '<div class="pc-empty">No payment channels matched your selection.</div>';
        return;
      }

      cardIdCounter = 0;
      grid.innerHTML = filtered.map(buildCard).join('');
      updateCodapayOnlyVisibility(product);
    }

    // Backend API Integration + Supported API Integration are only
    // meaningful for Codapay. Show them when Codapay is the selected
    // filter (or no filter is set, since that doesn't exclude Codapay);
    // hide them when a different product is explicitly selected.
    function updateCodapayOnlyVisibility(product) {
      const shouldShow = !product || product === 'Codapay';
      document.querySelectorAll('.pc-codapay-only').forEach(el => {
        el.classList.toggle('pc-hidden', !shouldShow);
      });
    }

    window.pcToggle = function (id, btn) {
      const el = document.getElementById(id);
      const isOpen = el.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    };

    document.getElementById('regionSelect').onchange = renderCards;
    document.getElementById('countrySelect').onchange = renderCards;
    document.getElementById('typeSelect').onchange = renderCards;
    document.getElementById('productSelect').onchange = renderCards;
    document.getElementById('searchInput').oninput = renderCards;

    loadData();
  </script>
</body>
</html>
